<Page
    x:Class="thefootballife.MyCareerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="My Career"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Your active football life save."
                       Foreground="#BBBBBB"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Career Profile"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Height="220"
                            Background="#2A2A2A"
                            CornerRadius="10">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock x:Name="PlayerNameText"
                               Text="Unnamed Player"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="PlayerSummaryText"
                               Text="No career data loaded yet."
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Career Details"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock x:Name="WeekText"
                               Text="Current Week: 1"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock x:Name="TeamText"
                               Text="Supported Team: -"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock x:Name="PositionText"
                               Text="Position: -"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock x:Name="MentalityText"
                               Text="Mentality: -"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock x:Name="PhysicalText"
                               Text="Physical: -"
                               Foreground="White"
                               FontSize="16"/>

                    <TextBlock x:Name="WeaknessesText"
                               Text="Weaknesses: -"
                               Foreground="White"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="Back to Career Hub"
                    Click="BackToCareerHubButton_Click"
                    MinWidth="180"
                    MinHeight="44"/>
        </StackPanel>
    </Grid>
</Page>