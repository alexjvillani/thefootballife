<Page
    x:Class="thefootballife.MainMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Image Source="Assets/MainMenuBackground.png"
               Stretch="UniformToFill"
               Opacity="0.95"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#AA08111A" Offset="0.0"/>
                    <GradientStop Color="#CC03070C" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <StackPanel VerticalAlignment="Top" Margin="0,70,0,0">
                <TextBlock
                    Text="THE FOOTBALL LIFE"
                    FontSize="52"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="White"/>

                <TextBlock
                    Text="AFL Career Simulation"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Foreground="#D0D0D0"
                    Margin="0,10,0,0"/>
            </StackPanel>

            <Border
                Width="380"
                Padding="30"
                Background="#66111A24"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <StackPanel Spacing="18">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="New Game" Click="NewGame_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Load Game" Click="LoadGame_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Settings" Click="Settings_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Credits" Click="Credits_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Exit" Click="Exit_Click"/>
                </StackPanel>
            </Border>

            <TextBlock
                Text="Version 03/07/2026"
                Foreground="#CCCCCC"
                Margin="20"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</Page>