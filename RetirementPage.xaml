<Page
    x:Class="thefootballife.RetirementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hanging Up the "
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Boots"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#D4A24C"/>
            </StackPanel>
            <TextBlock x:Name="PlayerNameSubtitleText"
                       Text=""
                       Foreground="#BBBBBB"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="720" Spacing="20">

            <Border Background="#1C1C1C" CornerRadius="16" Padding="30">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="CareerGradeText"
                               Text=""
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#D4A24C"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinalClubText"
                               Text=""
                               FontSize="15"
                               Foreground="#DDDDDD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1C1C1C" CornerRadius="10" Padding="14">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="GamesPlayedText" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Games Played" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="10" Padding="14">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="SeasonsPlayedText" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Seasons" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1C1C1C" CornerRadius="10" Padding="14">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="BestAndFairestText" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Best &amp; Fairest" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#1C1C1C" CornerRadius="10" Padding="14">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="FinalOverallText" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Final Overall" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#1C1C1C" CornerRadius="12" Padding="24">
                <TextBlock x:Name="EpilogueText"
                           Text=""
                           Foreground="#DDDDDD"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

        </StackPanel>

        <Button Grid.Row="2"
                Content="Return to Main Menu"
                Click="ReturnToMainMenuButton_Click"
                Background="#D4A24C"
                Foreground="#111111"
                FontWeight="Bold"
                MinWidth="220"
                MinHeight="48"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"/>
    </Grid>
</Page>
