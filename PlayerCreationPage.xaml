<Page
    x:Class="thefootballife.PlayerCreationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
            <TextBlock Text="Create Your Player"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Build your identity, background, and physical profile before moving to X-Factors."
                       FontSize="15"
                       Foreground="#BDBDBD"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">

                    <!-- Identity -->
                    <Border Background="#1C1C1C" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Player Details"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="First Name" Foreground="White"/>
                                    <TextBox x:Name="FirstNameTextBox"
                                             PlaceholderText="Enter first name"
                                             TextChanged="NameField_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Last Name" Foreground="White"/>
                                    <TextBox x:Name="LastNameTextBox"
                                             PlaceholderText="Enter last name"
                                             TextChanged="NameField_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Preferred Position" Foreground="White"/>
                                    <ComboBox x:Name="PositionComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Midfielder"/>
                                        <ComboBoxItem Content="Forward"/>
                                        <ComboBoxItem Content="Defender"/>
                                        <ComboBoxItem Content="Ruck"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Preferred Foot" Foreground="White"/>
                                    <ComboBox x:Name="FootComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Right"/>
                                        <ComboBoxItem Content="Left"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Preferred Number" Foreground="White"/>
                                    <TextBox x:Name="NumberTextBox"
                                             PlaceholderText="e.g. 9"
                                             MaxLength="2"
                                             TextChanged="PlayerField_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Supported AFL Team" Foreground="White"/>
                                    <ComboBox x:Name="TeamComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Adelaide"/>
                                        <ComboBoxItem Content="Brisbane"/>
                                        <ComboBoxItem Content="Carlton"/>
                                        <ComboBoxItem Content="Collingwood"/>
                                        <ComboBoxItem Content="Essendon"/>
                                        <ComboBoxItem Content="Fremantle"/>
                                        <ComboBoxItem Content="Geelong"/>
                                        <ComboBoxItem Content="Gold Coast"/>
                                        <ComboBoxItem Content="GWS"/>
                                        <ComboBoxItem Content="Hawthorn"/>
                                        <ComboBoxItem Content="Melbourne"/>
                                        <ComboBoxItem Content="North Melbourne"/>
                                        <ComboBoxItem Content="Port Adelaide"/>
                                        <ComboBoxItem Content="Richmond"/>
                                        <ComboBoxItem Content="St Kilda"/>
                                        <ComboBoxItem Content="Sydney"/>
                                        <ComboBoxItem Content="West Coast"/>
                                        <ComboBoxItem Content="Western Bulldogs"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Background -->
                    <Border Background="#1C1C1C" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Background"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="State of Origin" Foreground="White"/>
                                    <ComboBox x:Name="StateComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Victoria"/>
                                        <ComboBoxItem Content="South Australia"/>
                                        <ComboBoxItem Content="Western Australia"/>
                                        <ComboBoxItem Content="New South Wales"/>
                                        <ComboBoxItem Content="Queensland"/>
                                        <ComboBoxItem Content="Tasmania"/>
                                        <ComboBoxItem Content="Northern Territory"/>
                                        <ComboBoxItem Content="ACT"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Family Situation" Foreground="White"/>
                                    <Border Background="#262626" CornerRadius="8" Padding="12">
                                        <TextBlock x:Name="FamilySituationText"
                                                   Text="Randomised when profile is generated"
                                                   Foreground="#D7D7D7"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="School Type" Foreground="White"/>
                                    <ComboBox x:Name="SchoolComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Public School"/>
                                        <ComboBoxItem Content="Private School"/>
                                        <ComboBoxItem Content="Sports Academy"/>
                                        <ComboBoxItem Content="Country School"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Region" Foreground="White"/>
                                    <ComboBox x:Name="RegionComboBox"
                                              SelectedIndex="0"
                                              SelectionChanged="PlayerField_Changed">
                                        <ComboBoxItem Content="Metro"/>
                                        <ComboBoxItem Content="Regional"/>
                                        <ComboBoxItem Content="Country"/>
                                        <ComboBoxItem Content="Remote"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Physical Build -->
                    <Border Background="#1C1C1C" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Physical Build"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <CheckBox x:Name="ManualPhysicalCheckBox"
                                      Content="Choose height and weight manually"
                                      Foreground="White"
                                      RequestedTheme="Dark"
                                      Checked="ManualPhysicalCheckBox_Changed"
                                      Unchecked="ManualPhysicalCheckBox_Changed"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Height (feet/inches)" Foreground="White"/>
                                    <TextBox x:Name="HeightTextBox"
                                             PlaceholderText="e.g. 6'2&quot;"
                                             IsEnabled="False"
                                             TextChanged="PlayerField_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Weight (kg)" Foreground="White"/>
                                    <TextBox x:Name="WeightTextBox"
                                             PlaceholderText="e.g. 84"
                                             IsEnabled="False"
                                             TextChanged="PlayerField_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="If left unchecked, height and weight will be randomised for this player."
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- X-Factor Teaser -->
                    <Border Background="#1C1C1C" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="X-Factors"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Text="Mental and physical X-Factors now have their own screen so each trait can be presented properly."
                                       Foreground="#D0D0D0"
                                       TextWrapping="Wrap"/>

                            <Border Background="#262626" CornerRadius="10" Padding="12">
                                <TextBlock Text="You’ll choose detailed X-Factors after this page."
                                           Foreground="#E6E6E6"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT SIDE -->
            <Border Grid.Column="1"
                    Background="#1C1C1C"
                    CornerRadius="14"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Generated Profile"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <!-- Random Person -->
                        <Border Background="#262626" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Generated Prospect"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <Border CornerRadius="10"
                                        Height="220"
                                        Background="#3A3A3A"
                                        Clip="{x:Null}">
                                    <Image x:Name="ProfileImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Summary -->
                        <Border Background="#262626" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="SummaryNameText"
                                           Text="Name: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummaryBuildText"
                                           Text="Height / Weight: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummaryPotentialText"
                                           Text="Potential Height: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummaryDistanceText"
                                           Text="Distance to Club: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummarySchoolText"
                                           Text="School Quality: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummaryFinanceText"
                                           Text="Finances: -"
                                           Foreground="White"
                                           FontSize="16"/>

                                <TextBlock x:Name="SummaryFamilyText"
                                           Text="Family Situation: -"
                                           Foreground="White"
                                           FontSize="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Outlook -->
                        <Border Background="#262626" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Career Outlook"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="CareerOutlookText"
                                           Text="Generate a profile preview to see how your prospect is shaping up."
                                           Foreground="#DDDDDD"
                                           TextWrapping="Wrap"
                                           FontSize="15"/>
                            </StackPanel>
                        </Border>

                        <!-- Preview Button -->
                        <Button Content="Generate Final Variables"
                                Click="GeneratePreview_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Back"
                    Click="BackButton_Click"
                    Margin="0,0,12,0"
                    MinWidth="120"/>

            <Button Grid.Column="2"
                    Content="Continue to X-Factors"
                    Click="ContinueButton_Click"
                    MinWidth="190"/>
        </Grid>
    </Grid>
</Page>
