<Page
    x:Class="thefootballife.TeamAssignmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">
    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="6">
            <TextBlock Text="Local Team Assignment"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock x:Name="HeaderText"
                       Text="Generated clubs based on your origin and distance to club profile."
                       Foreground="#C8C8C8"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <!-- Assigned club panel -->
            <Border Grid.Column="0" Background="#1C1C1C" CornerRadius="12" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Closest Club Match"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <Border Background="#262626" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="AssignedTeamText"
                                       Text="Club pending"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AssignedLeagueText"
                                       Text="League"
                                       Foreground="#AAAAAA"
                                       FontStyle="Italic"/>
                            <TextBlock x:Name="AssignedSuburbText"
                                       Text="Suburb"
                                       Foreground="#DDDDDD"/>
                            <TextBlock x:Name="AssignedDistanceText"
                                       Text="Distance match"
                                       Foreground="#DDDDDD"/>
                            <TextBlock x:Name="AssignedColourText"
                                       Text="Colours"
                                       Foreground="#DDDDDD"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AssignedGroundText"
                                       Text="Home ground"
                                       Foreground="#DDDDDD"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="AssignedReputationText"
                                       Text="Reputation"
                                       Foreground="#DDDDDD"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="This club becomes your original playing team when you start your career."
                               Foreground="#BDBDBD"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- All clubs list -->
            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="12" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="StateTeamsTitleText"
                               Text="10 clubs for your state"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TeamsListPanel" Spacing="8"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="Re-roll Clubs" Click="RegenerateButton_Click"/>
            <Button Content="Confirm Team &amp; Start Career" Click="ConfirmTeamButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
