<Page
    x:Class="thefootballife.XFactorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

	<Grid Padding="28">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Choose Your X-Factors"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"/>
			<TextBlock Text="Define what makes your player stand out."
                       Foreground="#BBBBBB"
                       Margin="0,6,0,0"/>
		</StackPanel>

		<Grid Grid.Row="1" ColumnSpacing="20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="#1C1C1C" CornerRadius="12" Padding="20">
				<StackPanel Spacing="12">
					<TextBlock Text="Mentality"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

					<ComboBox x:Name="MentalityComboBox"
                              SelectedIndex="0"
                              SelectionChanged="MentalityComboBox_SelectionChanged">
						<ComboBoxItem Content="Composed"/>
						<ComboBoxItem Content="Aggressive"/>
						<ComboBoxItem Content="Clutch Performer"/>
						<ComboBoxItem Content="Natural Leader"/>
						<ComboBoxItem Content="High Work Rate"/>
					</ComboBox>

					<TextBlock x:Name="MentalityDescriptionText"
                               Text="Keeps control under pressure."
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="1" Background="#1C1C1C" CornerRadius="12" Padding="20">
				<StackPanel Spacing="12">
					<TextBlock Text="Physical"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

					<ComboBox x:Name="PhysicalComboBox"
                              SelectedIndex="0"
                              SelectionChanged="PhysicalComboBox_SelectionChanged">
						<ComboBoxItem Content="Explosive Speed"/>
						<ComboBoxItem Content="Elite Endurance"/>
						<ComboBoxItem Content="Strong Marking"/>
						<ComboBoxItem Content="Powerful Frame"/>
						<ComboBoxItem Content="Agility"/>
					</ComboBox>

					<TextBlock x:Name="PhysicalDescriptionText"
                               Text="Breaks away from contests quickly."
                               Foreground="#DDDDDD"
                               TextWrapping="Wrap"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="2" Background="#1C1C1C" CornerRadius="12" Padding="20">
				<StackPanel Spacing="10">
					<TextBlock Text="Weaknesses"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

					<CheckBox x:Name="WeaknessKick"
                              Content="Inconsistent Kicking"
                              Checked="WeaknessCheckBox_Changed"
                              Unchecked="WeaknessCheckBox_Changed"
                              Foreground="White"/>

					<CheckBox x:Name="WeaknessFitness"
                              Content="Low Endurance"
                              Checked="WeaknessCheckBox_Changed"
                              Unchecked="WeaknessCheckBox_Changed"
                              Foreground="White"/>

					<CheckBox x:Name="WeaknessDecision"
                              Content="Poor Decision Making"
                              Checked="WeaknessCheckBox_Changed"
                              Unchecked="WeaknessCheckBox_Changed"
                              Foreground="White"/>

					<CheckBox x:Name="WeaknessPressure"
                              Content="Struggles Under Pressure"
                              Checked="WeaknessCheckBox_Changed"
                              Unchecked="WeaknessCheckBox_Changed"
                              Foreground="White"/>

					<Border Background="#262626" CornerRadius="10" Padding="12" Margin="0,10,0,0">
						<TextBlock x:Name="TraitSummaryText"
                                   Text="Choose your standout mentality and physical strengths."
                                   Foreground="#DDDDDD"
                                   TextWrapping="Wrap"/>
					</Border>
				</StackPanel>
			</Border>
		</Grid>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">

			<Button Content="Back"
                    Click="BackButton_Click"/>

			<Button Content="Continue"
                    Click="ContinueButton_Click"/>
		</StackPanel>
	</Grid>
</Page>