<Page
    x:Class="thefootballife.CareerHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Career Hub"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Manage your week and shape your future."
                       Foreground="#BBBBBB"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Main Layout -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Player Card -->
            <Border Grid.Column="0"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Player Card"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Height="220"
                            Background="#2A2A2A"
                            CornerRadius="10">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock x:Name="PlayerNameText"
                               Text="Alex Villani"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="PlayerInfoText"
                               Text="Midfielder | Right Foot | #9"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="HeightText"
                               Text="Height: 6'1&quot;"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="MentalityText"
                               Text="Mentality: Composed"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="PhysicalText"
                               Text="Physical: Explosive Speed"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="WeaknessesText"
                               Text="Weaknesses: None selected"
                               Foreground="#DDDDDD"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Center: Current Week / Status -->
            <Border Grid.Column="1"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Current Week"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Background="#262626"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WeekText"
                                       Text="Week 1"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock x:Name="StatusText"
                                       Text="Status: Local League Prospect"
                                       FontSize="18"
                                       Foreground="#DDDDDD"/>

                            <TextBlock x:Name="SeasonText"
                                       Text="Season Phase: School Season"
                                       FontSize="16"
                                       Foreground="#BBBBBB"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#262626"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Weekly Outlook"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock x:Name="WeeklyOutlookText"
                                       Text="A fresh week ahead. Focus on balancing development, performance, and life outside footy."
                                       TextWrapping="Wrap"
                                       Foreground="#DDDDDD"
                                       FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#262626"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Development Snapshot"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock x:Name="DevelopmentText"
                                       Text="Training form is steady. Recruiters have not yet locked onto your progress."
                                       TextWrapping="Wrap"
                                       Foreground="#DDDDDD"
                                       FontSize="15"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Quick Actions -->
            <Border Grid.Column="2"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Quick Actions"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Button Content="Train"
                            Click="TrainButton_Click"
                            MinHeight="44"/>

                    <Button Content="Play Match"
                            Click="PlayMatchButton_Click"
                            MinHeight="44"/>

                    <Button Content="Rest / Social"
                            Click="RestButton_Click"
                            MinHeight="44"/>

                    <Button Content="Study"
                            Click="StudyButton_Click"
                            MinHeight="44"/>

                    <Border Background="#262626"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,10,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Last Choice"
                                       Foreground="#BBBBBB"/>
                            <TextBlock x:Name="LastChoiceText"
                                       Text="No action chosen yet."
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="BottomHintText"
                       Grid.Column="0"
                       Text="Choose an action, then advance the week."
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Save Game"
                    Click="SaveGameButton_Click"
                    MinWidth="140"
                    MinHeight="44"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Exit to My Career"
                    Click="ExitToMyCareerButton_Click"
                    MinWidth="170"
                    MinHeight="44"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="3"
                    Content="Advance Week"
                    Click="AdvanceWeekButton_Click"
                    MinWidth="160"
                    MinHeight="44"/>
        </Grid>
    </Grid>
</Page>