<Page
    x:Class="thefootballife.CareerHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Career Hub"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Manage your week and shape your future."
                       Foreground="#BBBBBB"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Main columns -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Column 0: Player Card ── -->
            <Border Grid.Column="0"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Player Card"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Height="220"
                            Background="#2A2A2A"
                            CornerRadius="10">
                        <Image x:Name="ProfileImage"
                               Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock x:Name="PlayerNameText"
                               Text="Player Name"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock x:Name="PlayerInfoText"
                               Text="Midfielder | Right Foot | #9"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="HeightText"
                               Text="Height: —"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="MentalityText"
                               Text="Mentality: —"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="PhysicalText"
                               Text="Physical: —"
                               Foreground="#DDDDDD"
                               FontSize="16"/>

                    <TextBlock x:Name="WeaknessesText"
                               Text="Weaknesses: —"
                               Foreground="#DDDDDD"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── Column 1: Current Week ── -->
            <Border Grid.Column="1"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Current Week"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Background="#262626" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="WeekText"
                                       Text="Week 1"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Status: Local League Prospect"
                                       FontSize="18"
                                       Foreground="#DDDDDD"/>
                            <TextBlock x:Name="SeasonText"
                                       Text="Season Phase: School Season"
                                       FontSize="16"
                                       Foreground="#BBBBBB"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#262626" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Weekly Outlook"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="WeeklyOutlookText"
                                       Text="A fresh week ahead."
                                       TextWrapping="Wrap"
                                       Foreground="#DDDDDD"
                                       FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#262626" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Development Snapshot"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="DevelopmentText"
                                       Text="Training form is steady."
                                       TextWrapping="Wrap"
                                       Foreground="#DDDDDD"
                                       FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#262626" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Last Choice" Foreground="#BBBBBB"/>
                            <TextBlock x:Name="LastChoiceText"
                                       Text="No action chosen yet."
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Column 2: Life Simulation ── -->
            <Border Grid.Column="2"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Life Simulation"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock x:Name="BlockSummaryText"
                                   Text="14/14 blocks allocated"
                                   Foreground="#DDDDDD"/>

                        <TextBlock x:Name="BlockWarningText"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="#F6B93B"/>

                        <!-- Block rows -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Training" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Tag="Training" Click="DecrementBlockButton_Click" MinWidth="36"/>
                            <TextBlock Grid.Column="2" x:Name="TrainingBlocksText" Text="4" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Grid.Column="3" Content="+" Tag="Training" Click="IncrementBlockButton_Click" MinWidth="36"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="School" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Tag="School" Click="DecrementBlockButton_Click" MinWidth="36"/>
                            <TextBlock Grid.Column="2" x:Name="SchoolBlocksText" Text="5" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Grid.Column="3" Content="+" Tag="School" Click="IncrementBlockButton_Click" MinWidth="36"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Work" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Tag="Work" Click="DecrementBlockButton_Click" MinWidth="36"/>
                            <TextBlock Grid.Column="2" x:Name="WorkBlocksText" Text="2" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Grid.Column="3" Content="+" Tag="Work" Click="IncrementBlockButton_Click" MinWidth="36"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Social" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Tag="Social" Click="DecrementBlockButton_Click" MinWidth="36"/>
                            <TextBlock Grid.Column="2" x:Name="SocialBlocksText" Text="2" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Grid.Column="3" Content="+" Tag="Social" Click="IncrementBlockButton_Click" MinWidth="36"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recovery" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="-" Tag="Recovery" Click="DecrementBlockButton_Click" MinWidth="36"/>
                            <TextBlock Grid.Column="2" x:Name="RecoveryBlocksText" Text="1" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Grid.Column="3" Content="+" Tag="Recovery" Click="IncrementBlockButton_Click" MinWidth="36"/>
                        </Grid>

                        <Border Background="#262626" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Physical State" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PhysicalStateText" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                <TextBlock Text="Mental State" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="MentalStateText" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                                <TextBlock Text="Life State" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="LifeStateText" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#262626" CornerRadius="10" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Consequence Preview" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ConsequenceText" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Column 3: League Ladder / Fixtures ── -->
            <Border Grid.Column="3"
                    Background="#1C1C1C"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel Spacing="10">

                    <!-- View toggle -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Ladder"
                                Click="LadderViewButton_Click"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                Content="Fixtures"
                                Click="FixturesViewButton_Click"
                                HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Ladder view -->
                    <StackPanel x:Name="LadderContentPanel" Spacing="10" Visibility="Visible">
                        <TextBlock x:Name="LadderTitleText"
                                   Text="League Ladder"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <!-- Column headers -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="1" Text="Club" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="2" Text="P"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="3" Text="W"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="4" Text="L"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="5" Text="D"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="6" Text="%"   FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                            <TextBlock Grid.Column="7" Text="Pts" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#333333"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="480">
                            <StackPanel x:Name="LadderRowsPanel" Spacing="2"/>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Fixtures view -->
                    <StackPanel x:Name="FixturesContentPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="Fixtures"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="520">
                            <StackPanel x:Name="FixtureRowsPanel" Spacing="6"/>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="BottomHintText"
                       Grid.Column="0"
                       Text="Allocate all 14 blocks, then advance week."
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Save Game"
                    Click="SaveGameButton_Click"
                    MinWidth="140"
                    MinHeight="44"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Advance Week"
                    Click="AdvanceWeekButton_Click"
                    MinWidth="160"
                    MinHeight="44"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="3"
                    Content="Exit to Main Menu"
                    Click="ExitToMainMenuButton_Click"
                    MinWidth="170"
                    MinHeight="44"/>
        </Grid>
    </Grid>
</Page>
