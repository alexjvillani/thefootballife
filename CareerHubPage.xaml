<Page
    x:Class="thefootballife.CareerHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111214">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1B1C1F"/>
            <Setter Property="BorderBrush" Value="#2A2C31"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="#232529"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#2C2E34"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="MutedStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9AA0AA"/>
        </Style>
    </Page.Resources>

    <Grid Padding="28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar: week + Mon-Sun strip ── -->
        <StackPanel Grid.Row="0" Spacing="10">
            <!-- Debug-only tools; collapsed unless a Debug build (see constructor). -->
            <StackPanel x:Name="DebugToolsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="DEBUG" Foreground="#FF6B6B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Skip to Finals" Click="DebugSkipToFinalsButton_Click" FontSize="12" Padding="10,6"/>
                <Button Content="Skip to Season End" Click="DebugSkipToSeasonEndButton_Click" FontSize="12" Padding="10,6"/>
                <Button Content="Skip to Season End (Win B&amp;F)" Click="DebugSkipToSeasonEndWinBnFButton_Click" FontSize="12" Padding="10,6"/>
            </StackPanel>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="WeekText" Text="Week 1" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="DateText" Text="" Style="{StaticResource MutedStyle}"/>
                    <TextBlock x:Name="SeasonText" Text="" Style="{StaticResource MutedStyle}" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
                <!-- Cells are built in RenderDayStrip() -->
                <Grid x:Name="DayStripGrid" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <!-- ── Body: player column | pages ── -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Persistent player column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <Border Width="132" Height="132" CornerRadius="66" Background="#2A2210" BorderBrush="#F2B84B" BorderThickness="6" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="OverallText" Text="--" FontSize="48" FontWeight="Bold" Foreground="#F2B84B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="OVR" FontSize="11" CharacterSpacing="120" Foreground="#C9A35A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Portrait is kept (the code still loads it) but hidden in this layout. -->
                            <Border Visibility="Collapsed">
                                <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="PlayerNameText" Text="Player Name" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ClubText" Text="" Style="{StaticResource MutedStyle}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock x:Name="PositionChipText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock x:Name="FootChipText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock x:Name="NumberChipText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock x:Name="HeightChipText" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource TileStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MENTALITY" FontSize="11" CharacterSpacing="100" Foreground="#9AA0AA"/>
                                        <TextBlock x:Name="MentalityText" Text="-" FontSize="17" FontWeight="Bold" Foreground="#7DB4FF" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="PHYSICAL" FontSize="11" CharacterSpacing="100" Foreground="#9AA0AA"/>
                                        <TextBlock x:Name="PhysicalText" Text="-" FontSize="17" FontWeight="Bold" Foreground="#F2B84B" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="WEAKNESSES" FontSize="11" CharacterSpacing="100" Foreground="#9AA0AA"/>
                                        <TextBlock x:Name="WeaknessesText" Text="-" FontSize="17" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="At a glance" Style="{StaticResource CardTitleStyle}"/>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Fatigue" Style="{StaticResource MutedStyle}"/>
                                    <TextBlock x:Name="GlanceFatigueValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                </Grid>
                                <ProgressBar x:Name="GlanceFatigueBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#E5894F" Background="#2C2E34"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Confidence" Style="{StaticResource MutedStyle}"/>
                                    <TextBlock x:Name="GlanceConfidenceValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                </Grid>
                                <ProgressBar x:Name="GlanceConfidenceBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Stress" Style="{StaticResource MutedStyle}"/>
                                    <TextBlock x:Name="GlanceStressValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                </Grid>
                                <ProgressBar x:Name="GlanceStressBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#E5894F" Background="#2C2E34"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Page switcher + pages -->
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="WeekTabButton" Content="Week" Tag="Week" Click="PageTabButton_Click" MinWidth="110" MinHeight="40" FontWeight="SemiBold" Foreground="White"/>
                    <Button x:Name="TeamTabButton" Content="Team" Tag="Team" Click="PageTabButton_Click" MinWidth="110" MinHeight="40" FontWeight="SemiBold" Foreground="White"/>
                    <Button x:Name="PersonalTabButton" Content="Personal" Tag="Personal" Click="PageTabButton_Click" MinWidth="110" MinHeight="40" FontWeight="SemiBold" Foreground="White"/>
                    <Button x:Name="CareerTabButton" Content="Career" Tag="Career" Click="PageTabButton_Click" MinWidth="110" MinHeight="40" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <Grid Grid.Row="1">

                    <!-- ═══ Week page ═══ -->
                    <ScrollViewer x:Name="WeekPagePanel" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel Spacing="20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="Allocate your week" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Name="BlockSummaryText" Text="" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Training" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="-" Tag="Training" Click="DecrementBlockButton_Click" MinWidth="36"/>
                                            <TextBlock Grid.Column="2" x:Name="TrainingBlocksText" Text="0" Foreground="White" FontWeight="SemiBold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="+" Tag="Training" Click="IncrementBlockButton_Click" MinWidth="36"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="School" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="-" Tag="School" Click="DecrementBlockButton_Click" MinWidth="36"/>
                                            <TextBlock Grid.Column="2" x:Name="SchoolBlocksText" Text="0" Foreground="White" FontWeight="SemiBold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="+" Tag="School" Click="IncrementBlockButton_Click" MinWidth="36"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Work" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="-" Tag="Work" Click="DecrementBlockButton_Click" MinWidth="36"/>
                                            <TextBlock Grid.Column="2" x:Name="WorkBlocksText" Text="0" Foreground="White" FontWeight="SemiBold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="+" Tag="Work" Click="IncrementBlockButton_Click" MinWidth="36"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Social" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="-" Tag="Social" Click="DecrementBlockButton_Click" MinWidth="36"/>
                                            <TextBlock Grid.Column="2" x:Name="SocialBlocksText" Text="0" Foreground="White" FontWeight="SemiBold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="+" Tag="Social" Click="IncrementBlockButton_Click" MinWidth="36"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Recovery" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="-" Tag="Recovery" Click="DecrementBlockButton_Click" MinWidth="36"/>
                                            <TextBlock Grid.Column="2" x:Name="RecoveryBlocksText" Text="0" Foreground="White" FontWeight="SemiBold" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="+" Tag="Recovery" Click="IncrementBlockButton_Click" MinWidth="36"/>
                                        </Grid>
                                        <TextBlock x:Name="TodayBlocksText" Text="" FontSize="12" Foreground="#9AA0AA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="BlockWarningText" Text="" FontSize="12" TextWrapping="Wrap" Foreground="#F6B93B"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="Condition" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock Text="Orange: lower is better" Style="{StaticResource MutedStyle}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnSpacing="16" RowSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Fatigue" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="FatigueValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="FatigueBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#E5894F" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Injury Risk" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="InjuryValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="InjuryBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#E5894F" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Recovery Quality" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="RecoveryValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="RecoveryBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Confidence" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="ConfidenceValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="ConfidenceBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Stress" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="StressValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="StressBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#E5894F" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Grid.Row="1" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Motivation" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="MotivationValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="MotivationBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Discipline" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="DisciplineValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="DisciplineBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="2" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Finances" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="FinancesValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="FinancesBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Grid.Row="2" Spacing="4">
                                                <Grid>
                                                    <TextBlock Text="Relationships" Style="{StaticResource MutedStyle}"/>
                                                    <TextBlock x:Name="RelationshipsValueText" Text="0" HorizontalAlignment="Right" Foreground="White" FontSize="13"/>
                                                </Grid>
                                                <ProgressBar x:Name="RelationshipsBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="20" VerticalAlignment="Top">
                                    <!-- Consequence preview: pills are built in RenderConsequencePills() -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <TextBlock Text="Consequence preview" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock Text="If the week ended now" Style="{StaticResource MutedStyle}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <RichTextBlock x:Name="ConsequencePillsText" IsTextSelectionEnabled="False" TextWrapping="Wrap"/>
                                            <!-- Narrative result, shown after a week is committed (ApplyWeekSimulation) -->
                                            <TextBlock x:Name="ConsequenceText" Foreground="#DDDDDD" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            <TextBlock x:Name="WeeklyOutlookText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TodayFocusText" Text="" TextWrapping="Wrap" FontSize="13" FontStyle="Italic" Foreground="#8FCB87"/>
                                            <TextBlock Text="Last choice" Style="{StaticResource MutedStyle}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="LastChoiceText" Text="No action chosen yet." Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Next match: filled by UpdateNextMatchUI() -->
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <TextBlock Text="Next match" Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock x:Name="WeekNextMatchDateText" Text="" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock x:Name="WeekNextMatchOpponentText" Text="" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="WeekNextMatchDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border x:Name="WeekNextMatchPill" Grid.Column="1" Background="#1E3A5F" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                                                    <TextBlock Text="Plan on the day" FontSize="12" FontWeight="SemiBold" Foreground="#9CC2FF" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="90"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Last match: stays collapsed until the first match is played. Table is built in RenderLastMatchSummary() -->
                                <Border x:Name="MatchSummaryPanel" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="Last match" Style="{StaticResource CardTitleStyle}"/>
                                            <TextBlock x:Name="MatchSummaryResultText" Text="" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid x:Name="MatchTableGrid" RowSpacing="2"/>
                                        <TextBlock Text="Goals.behinds, with the total points underneath." Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═══ Team page ═══ -->
                    <Grid x:Name="TeamPagePanel" ColumnSpacing="20" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="LadderSubTabButton" Grid.Column="0" Content="Ladder" Click="LadderViewButton_Click" HorizontalAlignment="Stretch" MinHeight="36" Foreground="White"/>
                                    <Button x:Name="FixturesSubTabButton" Grid.Column="1" Content="Fixtures" Click="FixturesViewButton_Click" HorizontalAlignment="Stretch" MinHeight="36" Foreground="White"/>
                                    <Button x:Name="SquadSubTabButton" Grid.Column="2" Content="Squad" Click="SquadViewButton_Click" HorizontalAlignment="Stretch" MinHeight="36" Foreground="White"/>
                                </Grid>

                                <StackPanel x:Name="LadderContentPanel" Spacing="10" Visibility="Visible">
                                    <TextBlock x:Name="LadderTitleText" Text="League Ladder" Style="{StaticResource CardTitleStyle}"/>
                                    <Grid Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="Club" FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="2" Text="P"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="3" Text="W"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="4" Text="L"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="5" Text="D"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="6" Text="%"    FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                        <TextBlock Grid.Column="7" Text="Pts"  FontSize="11" FontWeight="SemiBold" Foreground="#888888"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#333333"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                        <StackPanel x:Name="LadderRowsPanel" Spacing="2"/>
                                    </ScrollViewer>
                                </StackPanel>

                                <StackPanel x:Name="FixturesContentPanel" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="Fixtures" Style="{StaticResource CardTitleStyle}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                                        <StackPanel x:Name="FixtureRowsPanel" Spacing="6"/>
                                    </ScrollViewer>
                                </StackPanel>

                                <StackPanel x:Name="SquadContentPanel" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="Squad" Style="{StaticResource CardTitleStyle}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                                        <StackPanel x:Name="SquadRowsPanel" Spacing="6"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Team stats" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Grid.Column="1" x:Name="TeamNameText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TeamPositionText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Ladder position" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TeamRecordText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Record" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TeamPointsText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Ladder points" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="TeamPercentText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Percentage" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Next match: filled by UpdateNextMatchUI() -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="Next match" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock x:Name="TeamNextMatchDateText" Text="" Style="{StaticResource MutedStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:Name="TeamNextMatchOpponentText" Text="" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TeamNextMatchDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border x:Name="TeamNextMatchPill" Grid.Column="1" Background="#1E3A5F" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="Plan on the day" FontSize="12" FontWeight="SemiBold" Foreground="#9CC2FF" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="90"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ Personal page ═══ -->
                    <ScrollViewer x:Name="PersonalPagePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid ColumnSpacing="20" RowSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Relationship" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersRelBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersRelBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersRelHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersRelDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="PersRelBarPanel" Spacing="4" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="Relationship strength" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            <TextBlock x:Name="PersRelBarValueText" Text="" HorizontalAlignment="Right" Foreground="White" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar x:Name="PersRelBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Work" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersWorkBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersWorkBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersWorkHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersWorkDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PersWorkNoteText" Text="" Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Sponsorship" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersSponsBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersSponsBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersSponsHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersSponsDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="PersSponsBarPanel" Spacing="4" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="Sponsor trust" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            <TextBlock x:Name="PersSponsBarValueText" Text="" HorizontalAlignment="Right" Foreground="White" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar x:Name="PersSponsBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Transport" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersCarBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersCarBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersCarHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersCarDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Education" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersEduBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersEduBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersEduHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersEduDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="PersEduBarPanel" Spacing="4" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <TextBlock Text="Academics" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                            <TextBlock x:Name="PersEduBarValueText" Text="" HorizontalAlignment="Right" Foreground="White" FontSize="12"/>
                                        </Grid>
                                        <ProgressBar x:Name="PersEduBar" Minimum="0" Maximum="100" Value="0" Height="6" MinHeight="6" Foreground="#4C8DFF" Background="#2C2E34"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="Reputation &amp; training" Style="{StaticResource CardTitleStyle}"/>
                                        <Border x:Name="PersRepBadge" HorizontalAlignment="Right" CornerRadius="12" Padding="12,4" Background="#2C2E34">
                                            <TextBlock x:Name="PersRepBadgeText" Text="" FontSize="12" Foreground="#9AA0AA"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="PersRepHeadlineText" Text="" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PersRepDetailText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="Media" Style="{StaticResource MutedStyle}" FontSize="13"/>
                                        <TextBlock x:Name="PersRepMediaText" Text="-" HorizontalAlignment="Right" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="Extra training" Style="{StaticResource MutedStyle}" FontSize="13"/>
                                        <TextBlock x:Name="PersRepTrainingText" Text="-" HorizontalAlignment="Right" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="Family bond" Style="{StaticResource MutedStyle}" FontSize="13"/>
                                        <TextBlock x:Name="PersRepFamilyText" Text="-" HorizontalAlignment="Right" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <!-- ═══ Career page ═══ -->
                    <Grid x:Name="CareerPagePanel" ColumnSpacing="20" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="20">
                            <!-- Career story: bars stay at an en dash until the story system feeds them -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock Text="Career story" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Builds as you choose" Style="{StaticResource MutedStyle}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnSpacing="20" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="5">
                                            <Grid>
                                                <TextBlock Text="Family bond" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                                <TextBlock x:Name="StoryFamilyBondValueText" Text="&#8211;" HorizontalAlignment="Right" Foreground="#9AA0AA" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar x:Name="StoryFamilyBondBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" Foreground="#4C8DFF" Background="#2C2E34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="5">
                                            <Grid>
                                                <TextBlock Text="Ambition" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                                <TextBlock x:Name="StoryAmbitionValueText" Text="&#8211;" HorizontalAlignment="Right" Foreground="#9AA0AA" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar x:Name="StoryAmbitionBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" Foreground="#4C8DFF" Background="#2C2E34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="5">
                                            <Grid>
                                                <TextBlock Text="Mentor trust" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                                <TextBlock x:Name="StoryMentorTrustValueText" Text="&#8211;" HorizontalAlignment="Right" Foreground="#9AA0AA" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar x:Name="StoryMentorTrustBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" Foreground="#4C8DFF" Background="#2C2E34"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="5">
                                            <Grid>
                                                <TextBlock Text="Independence" Style="{StaticResource MutedStyle}" FontSize="12"/>
                                                <TextBlock x:Name="StoryIndependenceValueText" Text="&#8211;" HorizontalAlignment="Right" Foreground="#9AA0AA" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar x:Name="StoryIndependenceBar" Minimum="0" Maximum="100" Value="0" Height="4" MinHeight="4" Foreground="#4C8DFF" Background="#2C2E34"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Career totals" Style="{StaticResource CardTitleStyle}"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="CareerGamesText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Games played" Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="CareerSeasonsText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Seasons" Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TileStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="CareerBestAndFairestText" Text="-" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Best &amp; Fairest wins" Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="20">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Career pathway" Style="{StaticResource CardTitleStyle}"/>
                                    <!-- Rows are built in UpdateCareerUI() -->
                                    <StackPanel x:Name="PathwayRowsPanel" Spacing="14"/>
                                    <TextBlock x:Name="DevelopmentText" Text="" Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="Journal" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Your decisions" Style="{StaticResource MutedStyle}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Style="{StaticResource TileStyle}">
                                        <TextBlock x:Name="JournalEmptyText" Text="Your choices will appear here as the story unfolds." Style="{StaticResource MutedStyle}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Footer ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="BottomHintText" Grid.Column="0" Text="Allocate all 14 blocks, then advance week." Foreground="#AAAAAA" VerticalAlignment="Center"/>

            <ToggleSwitch x:Name="AutoAdvanceToggle" Grid.Column="1" Header="" OnContent="Auto-Advance: On" OffContent="Auto-Advance: Off" IsOn="False" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="Save Game" Click="SaveGameButton_Click" MinWidth="140" MinHeight="44" Margin="0,0,10,0"/>

            <Button x:Name="AdvanceWeekButton" Grid.Column="3" Content="Advance Week" Click="AdvanceWeekButton_Click" MinWidth="160" MinHeight="44" Margin="0,0,10,0"/>

            <Button x:Name="NextSeasonButton" Grid.Column="4" Content="Start Next Season" Click="NextSeasonButton_Click" Background="#2E7D32" Foreground="White" MinWidth="170" MinHeight="44" Margin="0,0,10,0" Visibility="Collapsed"/>

            <Button x:Name="DraftNightButton" Grid.Column="4" Content="Draft Night" Click="DraftNightButton_Click" Background="#D4A24C" Foreground="#111111" FontWeight="Bold" MinWidth="170" MinHeight="44" Margin="0,0,10,0" Visibility="Collapsed"/>

            <Button x:Name="RetireButton" Grid.Column="5" Content="Retire" Click="RetireButton_Click" Background="#5C2E2E" Foreground="White" MinWidth="110" MinHeight="44" Margin="0,0,10,0" Visibility="Collapsed"/>

            <Button Grid.Column="6" Content="Exit to Main Menu" Click="ExitToMainMenuButton_Click" MinWidth="170" MinHeight="44"/>
        </Grid>
    </Grid>
</Page>
