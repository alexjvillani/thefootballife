<Page
    x:Class="thefootballife.ConfirmPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:thefootballife"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#111111">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
            <TextBlock Text="Confirm Your Player"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Review all details before entering Career Hub."
                       Foreground="#BDBDBD"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="18">
                <Border Background="#1C1C1C" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Player Identity" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="IdentityText" Foreground="#E2E2E2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C1C" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Background & Build" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="BackgroundText" Foreground="#E2E2E2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C1C" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="X-Factors" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="XFactorText" Foreground="#E2E2E2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Content="Back"
                    Click="BackButton_Click"/>
            <Button Content="Start Career"
                    Click="StartCareerButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
